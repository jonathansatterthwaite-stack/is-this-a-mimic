<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme; values-night overrides it. The WebView's prefers-color-scheme follows the theme. -->
    <style name="PackRatTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="bg">#F4ECDC</color>
    <color name="accent">#A4431F</color>
</resources>
